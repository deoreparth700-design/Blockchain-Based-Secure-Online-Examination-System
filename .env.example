# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# Neon PostgreSQL connection string (include ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Flask session secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-random-secret-key

# Optional: set to True for local development only, default is False
FLASK_DEBUG=False

# Ethereum Sepolia configuration (public smart contract address)
ETHEREUM_CONTRACT_ADDRESS=0x3eF059520E989c3E0b8481C7C5F875786F62ff91
ETHEREUM_CHAIN_ID=11155111
